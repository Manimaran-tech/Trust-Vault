# ============================================
# TrustVault Configuration
# ============================================

# --- LLM ---
# Ollama (default): http://localhost:11434/v1
# NVIDIA NIM:       http://localhost:8000/v1
# OpenAI:           https://api.openai.com/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Database ---
DATABASE_URL=postgresql+asyncpg://trustvault:trustvault@localhost:5432/trustvault

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=trustvault-dev-secret-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seed user passwords (initial dev setup only)
SEED_ADMIN_PASSWORD=
SEED_CSR_PASSWORD=
SEED_MEMBER_PASSWORD=

# --- App ---
APP_NAME=TrustVault
APP_ENV=development
DEBUG=true

# --- Rate limiting ---
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=10


# ============================================
# Market perception
# ============================================

# binance — public spot websocket, no API key required
# finnhub  — requires MARKET_API_KEY
# replay   — deterministic offline generator, for demos and tests
MARKET_FEED_PROVIDER=binance
MARKET_API_KEY=

# Instruments the agent may perceive and trade.
MARKET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# An observation older than this cannot justify a trade. Time-sensitivity is a
# hard constraint, not a preference: a stale reading describes a market that may
# no longer exist.
MARKET_STALENESS_SECONDS=5.0

# Ticks retained for volatility, momentum and correlation.
MARKET_VOL_WINDOW=120

# --- News / sentiment ---
NEWS_FEED_ENABLED=true
NEWS_POLL_SECONDS=60


# ============================================
# Capital and risk constraints
# ============================================
# These are the human-defined limits the agent operates inside. It decides
# whether and how to act; it cannot relax these itself. They are copied into the
# portfolio at creation and can then be changed at runtime through the API or by
# voice, within validated bounds.

STARTING_CAPITAL=1000000.0

# Share of NAV deployable across all open positions at once.
MAX_EXPOSURE_PCT=0.60

# Share of NAV any single position may consume.
MAX_POSITION_PCT=0.15

# Annualised volatility positions are sized toward.
TARGET_VOL=0.20

# Loss from peak NAV that halts new positions. Existing positions can still be
# closed — trapping the desk in its risk would make the breaker harmful.
MAX_DRAWDOWN_PCT=0.15

# Per-side execution fee, in basis points. This materially decides whether the
# desk can trade: a momentum edge measured over minutes does not survive a
# 10 bps fee. 2 bps reflects a liquid venue's taker tier.
FEE_BPS=2.0

# Reject a trade whose modelled slippage eats more than this share of its edge.
MAX_SLIPPAGE_SHARE_OF_EDGE=0.50

# Minimum edge, after costs, required to act at all.
MIN_EDGE_BPS=5.0


# ============================================
# Autonomous decision loop
# ============================================

AUTONOMOUS_LOOP_ENABLED=true

# How often the agent re-perceives the market and re-scores open positions.
DECISION_INTERVAL_SECONDS=15

# Re-run the full pipeline on an open position once price has moved this many
# rolling standard deviations since the decision was made. Measured in the
# instrument's own volatility, because a 1% move means different things in
# different books.
REASSESS_SIGMA_TRIGGER=1.5


# ============================================
# Adaptation
# ============================================

# Closed positions required before an agent's weight starts moving.
ADAPTATION_MIN_SAMPLES=10

# How strongly realised hit rate pulls an agent's consensus weight. 0 disables
# adaptation and freezes the desk into a fixed strategy.
ADAPTATION_LEARNING_RATE=0.15


# ============================================
# Stitch — ledger and execution rails
# ============================================
# With these set, every movement of capital is posted to Stitch's programmable
# double-entry ledger and mirrored locally. Without them the built-in local
# ledger is used and the loop still runs end to end; the active provider is
# logged at startup and reported at /api/telemetry/infrastructure.

STITCH_BASE_URL=https://api.stitch.co
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_LEDGER_ID=


# ============================================
# ElevenLabs — voice narration and spoken constraints
# ============================================
# Without a key, narration text is still broadcast to the dashboard; only the
# audio is unavailable. Voice is a reporting and constraint channel: a spoken
# instruction can change the risk envelope or halt the desk, but cannot order a
# specific trade.

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_AGENT_ID=
VOICE_NARRATION_ENABLED=true
