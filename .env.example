# ============================================
# TrustVault Configuration (Example Template)
# ============================================

# LLM Configuration
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=hf.co/unsloth/gemma-4-E4B-it-GGUF
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Database
# Use postgresql+asyncpg://... for PostgreSQL or sqlite+aiosqlite:///... for local SQLite
DATABASE_URL=sqlite+aiosqlite:///./trustvault.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — Generate a strong secret for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seed user passwords (for initial dev setup)
SEED_ADMIN_PASSWORD=
SEED_CSR_PASSWORD=
SEED_MEMBER_PASSWORD=

# App
APP_NAME=TrustVault
APP_ENV=development
DEBUG=false

# Rate Limiting
RATE_LIMIT_GENERAL=300
RATE_LIMIT_AUTH=10

# ============================================
# Market perception (added for the autonomous desk)
# ============================================
# "replay" runs fully offline with a deterministic generator; "binance" uses the
# public spot websocket; "angelone" uses Angel One SmartAPI for Indian equities.
MARKET_FEED_PROVIDER=replay
MARKET_SYMBOLS=RELIANCE,HDFCBANK,INFY,TCS,ICICIBANK
MARKET_STALENESS_SECONDS=5.0
MARKET_VOL_WINDOW=120

NEWS_FEED_ENABLED=false
NEWS_POLL_SECONDS=120

# --- Capital and risk constraints ---
STARTING_CAPITAL=1000000.0
MAX_EXPOSURE_PCT=0.60
MAX_POSITION_PCT=0.15
TARGET_VOL=0.20
MAX_DRAWDOWN_PCT=0.15
FEE_BPS=2.0
MAX_SLIPPAGE_SHARE_OF_EDGE=0.50
MIN_EDGE_BPS=2.0

# --- Decision loop ---
AUTONOMOUS_LOOP_ENABLED=true
# 30s rather than 15s: a local 8B model takes real time to answer seven agents,
# and overlapping cycles would queue requests faster than Ollama drains them.
DECISION_INTERVAL_SECONDS=30
REASSESS_SIGMA_TRIGGER=1.5

# --- Adaptation ---
ADAPTATION_MIN_SAMPLES=3
ADAPTATION_LEARNING_RATE=0.15

# --- Stitch (unset: the local double-entry ledger is used) ---
STITCH_BASE_URL=https://api.stitch.co
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_LEDGER_ID=

# --- ElevenLabs (unset: narration text still broadcasts, audio does not) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
VOICE_NARRATION_ENABLED=true

# Payment/transaction quorum runs deterministic rules only (sub-millisecond).
# The trading loop still reasons with the LLM — see TRANSACTION_LLM_ENABLED.
TRANSACTION_LLM_ENABLED=false
LLM_KEEP_ALIVE=30m
LLM_MAX_TOKENS=300
LLM_HEALTHCHECK_TIMEOUT=90

# --- Angel One SmartAPI (Indian equity market data) ---
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
